<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Audit Logs</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body>

<div class="dashboard-container">

    <h1>Audit Logs</h1>

    <% if (error) { %>

        <div class="error">
            <%= error %>
        </div>

    <% } %>

    <table
        border="1"
        cellpadding="10"
        width="100%"
    >

        <thead>

            <tr>
                <th>Date</th>
                <th>User</th>
                <th>Action</th>
                <th>Target</th>
                <th>Description</th>
                <th>IP Address</th>
            </tr>

        </thead>

        <tbody>

            <% logs.forEach(log => { %>

                <tr>

                    <td>
                        <%= log.createdAt.toLocaleString() %>
                    </td>

                    <td>
                        <%= log.userId ?
                            log.userId.username :
                            "Unknown" %>
                    </td>

                    <td>
                        <%= log.action %>
                    </td>

                    <td>
                        <%= log.target %>
                    </td>

                    <td>
                        <%= log.description %>
                    </td>

                    <td>
                        <%= log.ipAddress || "-" %>
                    </td>

                </tr>

            <% }) %>

        </tbody>

    </table>

    <br>

    <a href="/dashboard">
        Back to Dashboard
    </a>

</div>

</body>

</html>