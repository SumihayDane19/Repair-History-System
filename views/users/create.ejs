<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Create User</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body>

<div class="auth-container">

    <h1>Create User</h1>

    <% if (error) { %>

        <div class="error">
            <%= error %>
        </div>

    <% } %>

    <form
        method="POST"
        action="/users/create"
    >

        <label>
            Username
        </label>

        <input
            type="text"
            name="username"
            required
        >

        <label>
            Email
        </label>

        <input
            type="email"
            name="email"
            required
        >

        <label>
            Password
        </label>

        <input
            type="password"
            name="password"
            minlength="8"
            required
        >

        <label>
            Confirm Password
        </label>

        <input
            type="password"
            name="confirmPassword"
            minlength="8"
            required
        >

        <label>
            Role
        </label>

        <select name="role" required>

            <option value="staff">
                Staff
            </option>

            <option value="technician">
                Technician
            </option>

            <option value="administrator">
                Administrator
            </option>

        </select>

        <button type="submit">
            Create User
        </button>

    </form>

    <p>
        <a href="/users">
            Back to User Management
        </a>
    </p>

</div>

</body>

</html>