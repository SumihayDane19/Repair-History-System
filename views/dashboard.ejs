<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Dashboard
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body>

    <div class="dashboard-container">

        <h1>
            Repair History System
        </h1>


        <h2>
            Dashboard
        </h2>


        <p>
            Welcome,
            <strong>
                <%= username %>
            </strong>
        </p>


        <p>
            Role:
            <strong>
                <%= role %>
            </strong>
        </p>


        <hr>


        <h3>
            System Status
        </h3>
        <% if (role === "administrator") { %>
            <hr>
            <h3>
                Administrator
            </h3>
            <p>
                <a href="/users">
                    User & Role Management
                </a>
            </p>
            <p>
                <a href="/audit">
                    Audit Logs
                </a>
            </p>
            <% } %>

        <p>
            Authentication:
            Active
        </p>

        <p>
            Database:
            MongoDB
        </p>
        <p>
            <a href="/auth/setup-2fa">
                Setup Google Authenticator
            </a>
        </p>


        <a
            href="/auth/logout"
        >
            Logout
        </a>

    </div>

</body>

</html>